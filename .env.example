# Copie este arquivo para ".env" e ajuste os valores se quiser.
# Nunca versione o arquivo .env real.

# Porta da aplicação no host (http://localhost:8080)
APP_PORT=8080

# MySQL (usado pelo docker-compose e pelo "dotnet ef" em tempo de design)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=saleswebmvc
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
